---
/* RaaSki — Cluster Status & Distributed Node Map.
   Real-time operational dashboard for 64 autonomous bot nodes,
   residential proxy clusters, and Discord/POS gateway infrastructure. */
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout
  title="Cluster Status & Distributed Node Map | RaaSki"
  description="Real-time operational metrics across distributed bot worker nodes, Discord gateway sharding clusters, and vendor POS integration bridges."
  canonicalPath="/status"
>
  <section class="status-page section" aria-label="Cluster Status & Node Map">
    <div class="container status-container">
      <!-- Status Top Header -->
      <div class="status-header reveal">
        <div class="section-tag-badge">
          <span class="tag-badge-dot"></span>
          <span>SYSTEM HEALTH &bull; TELEMETRY</span>
        </div>
        <h1 class="status-title">Cluster Status &amp; Node Map</h1>
        <p class="status-subtitle">
          Real-time operational metrics across 64 distributed residential bot nodes,
          Discord Gateway sharding clusters, and vendor POS integration bridges.
        </p>

        <!-- Global Status Beacon Card -->
        <div class="global-status-banner">
          <div class="global-status-left">
            <span class="global-radar-beacon"></span>
            <div>
              <h2 class="global-status-heading">All Systems Operational</h2>
              <p class="global-status-sub">64 / 64 nodes nominal &bull; Cloudflare Turnstile bypass rate: 100% &bull; Zero IP bans</p>
            </div>
          </div>
          <div class="global-status-uptime">
            <span class="uptime-val">99.98%</span>
            <span class="uptime-label">90-Day Verified SLA</span>
          </div>
        </div>
      </div>

      <!-- Core Cluster Infrastructure Strip -->
      <div class="cluster-summary-grid reveal" style="--delay: 100ms;">
        <div class="summary-card">
          <span class="summary-label">DISCORD GATEWAYS</span>
          <span class="summary-val text-indigo">120 SHARDS NOMINAL</span>
          <span class="summary-meta">&lt; 28ms WebSocket latency</span>
        </div>
        <div class="summary-card">
          <span class="summary-label">RESIDENTIAL SOCKS5 POOL</span>
          <span class="summary-val text-emerald">64 / 64 ACTIVE</span>
          <span class="summary-meta">Frankfurt, Virginia, Tokyo, London</span>
        </div>
        <div class="summary-card">
          <span class="summary-label">POS BRIDGE PIPELINE</span>
          <span class="summary-val text-cyan">HEALTHY (0 BACKLOG)</span>
          <span class="summary-meta">Square &bull; Clover &bull; Shopify</span>
        </div>
        <div class="summary-card">
          <span class="summary-label">OSINT SURVEILLANCE MESH</span>
          <span class="summary-val text-violet">24/7 ACTIVE</span>
          <span class="summary-meta">180ms breach alert dispatch</span>
        </div>
      </div>

      <!-- Distributed Node Map & Interactive Grid -->
      <div class="node-map-section reveal" style="--delay: 150ms;">
        <div class="node-map-header">
          <div class="node-header-left">
            <div class="map-dots">
              <span class="dot dot--red"></span>
              <span class="dot dot--yellow"></span>
              <span class="dot dot--green"></span>
            </div>
            <span class="node-map-title">DISTRIBUTED_NODE_MATRIX // 8 STRATEGIC REGIONS</span>
          </div>
          <button id="btn-refresh-nodes" class="node-refresh-btn" type="button">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M23 4v6h-6"></path>
              <path d="M1 20v-6h6"></path>
              <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
            </svg>
            <span id="refresh-label">Execute Live Ping Probe</span>
          </button>
        </div>

        <div class="nodes-grid" id="status-nodes-grid">
          <!-- Node 1: Frankfurt DE -->
          <div class="status-node-card" data-region="Frankfurt, DE" data-ip="185.220.101.46" data-base-ping="22">
            <div class="node-card-top">
              <span class="node-badge-id">NODE_EU_01</span>
              <span class="node-beacon-green"></span>
            </div>
            <h3 class="node-region-title">Frankfurt, Germany</h3>
            <p class="node-role-text">Primary Residential SOCKS5 &bull; Hardware Scraper</p>
            <div class="node-stats-row">
              <span class="node-ping-badge" data-ping-el>22ms</span>
              <span class="node-health-tag">100% HEALTH</span>
            </div>
          </div>

          <!-- Node 2: Virginia US -->
          <div class="status-node-card" data-region="Virginia, US" data-ip="194.26.29.110" data-base-ping="18">
            <div class="node-card-top">
              <span class="node-badge-id">NODE_US_EAST</span>
              <span class="node-beacon-green"></span>
            </div>
            <h3 class="node-region-title">Virginia, US-East</h3>
            <p class="node-role-text">Discord Gateway Relay &bull; POS Ingestion Bridge</p>
            <div class="node-stats-row">
              <span class="node-ping-badge" data-ping-el>18ms</span>
              <span class="node-health-tag">100% HEALTH</span>
            </div>
          </div>

          <!-- Node 3: London UK -->
          <div class="status-node-card" data-region="London, UK" data-ip="84.17.45.88" data-base-ping="24">
            <div class="node-card-top">
              <span class="node-badge-id">NODE_UK_01</span>
              <span class="node-beacon-green"></span>
            </div>
            <h3 class="node-region-title">London, UK</h3>
            <p class="node-role-text">OSINT Reconnaissance &bull; Pastebin Threat Crawler</p>
            <div class="node-stats-row">
              <span class="node-ping-badge" data-ping-el>24ms</span>
              <span class="node-health-tag">100% HEALTH</span>
            </div>
          </div>

          <!-- Node 4: Tokyo JP -->
          <div class="status-node-card" data-region="Tokyo, JP" data-ip="103.152.18.4" data-base-ping="38">
            <div class="node-card-top">
              <span class="node-badge-id">NODE_APAC_01</span>
              <span class="node-beacon-green"></span>
            </div>
            <h3 class="node-region-title">Tokyo, Japan</h3>
            <p class="node-role-text">Market Arbitrage Feed &bull; Multi-Exchange Webhook</p>
            <div class="node-stats-row">
              <span class="node-ping-badge" data-ping-el>38ms</span>
              <span class="node-health-tag">100% HEALTH</span>
            </div>
          </div>

          <!-- Node 5: Oregon US -->
          <div class="status-node-card" data-region="Oregon, US" data-ip="198.51.100.22" data-base-ping="16">
            <div class="node-card-top">
              <span class="node-badge-id">NODE_US_WEST</span>
              <span class="node-beacon-green"></span>
            </div>
            <h3 class="node-region-title">Oregon, US-West</h3>
            <p class="node-role-text">Discord Shard 01-32 &bull; Anti-Raid Heuristic Worker</p>
            <div class="node-stats-row">
              <span class="node-ping-badge" data-ping-el>16ms</span>
              <span class="node-health-tag">100% HEALTH</span>
            </div>
          </div>

          <!-- Node 6: Paris FR -->
          <div class="status-node-card" data-region="Paris, FR" data-ip="185.190.140.2" data-base-ping="21">
            <div class="node-card-top">
              <span class="node-badge-id">NODE_EU_02</span>
              <span class="node-beacon-green"></span>
            </div>
            <h3 class="node-region-title">Paris, France</h3>
            <p class="node-role-text">Celery Task Queue Worker Pool &bull; PDF Invoicing</p>
            <div class="node-stats-row">
              <span class="node-ping-badge" data-ping-el>21ms</span>
              <span class="node-health-tag">100% HEALTH</span>
            </div>
          </div>

          <!-- Node 7: Singapore SG -->
          <div class="status-node-card" data-region="Singapore, SG" data-ip="103.245.22.8" data-base-ping="42">
            <div class="node-card-top">
              <span class="node-badge-id">NODE_APAC_02</span>
              <span class="node-beacon-green"></span>
            </div>
            <h3 class="node-region-title">Singapore, SG</h3>
            <p class="node-role-text">E-Commerce Webhook Dispatch &bull; Redis Replica</p>
            <div class="node-stats-row">
              <span class="node-ping-badge" data-ping-el>42ms</span>
              <span class="node-health-tag">100% HEALTH</span>
            </div>
          </div>

          <!-- Node 8: Amsterdam NL -->
          <div class="status-node-card" data-region="Amsterdam, NL" data-ip="193.106.191.5" data-base-ping="25">
            <div class="node-card-top">
              <span class="node-badge-id">NODE_EU_03</span>
              <span class="node-beacon-green"></span>
            </div>
            <h3 class="node-region-title">Amsterdam, Netherlands</h3>
            <p class="node-role-text">DataDome Evasion Cluster &bull; Canvas Jitter Hub</p>
            <div class="node-stats-row">
              <span class="node-ping-badge" data-ping-el>25ms</span>
              <span class="node-health-tag">100% HEALTH</span>
            </div>
          </div>
        </div>

        <div class="node-inspect-bar" id="status-inspect-bar">
          <span class="inspect-beacon"></span>
          <span id="status-inspect-text">Click any node above to verify TLS certificate chain, proxy handshake, and current worker load.</span>
        </div>
      </div>

      <!-- Incident Log -->
      <div class="incident-history-section reveal" style="--delay: 200ms;">
        <h3 class="incident-history-title">Operational History &bull; Past 90 Days</h3>
        <div class="incident-card">
          <div class="incident-date">October 2026</div>
          <div class="incident-content">
            <span class="incident-status text-emerald">&bull; All Systems Nominal</span>
            <p class="incident-text">Zero outages recorded. Cloudflare Turnstile and DataDome bot detection heuristics successfully mitigated with 100% bypass efficiency across all 172+ active vendor clients.</p>
          </div>
        </div>
        <div class="incident-card">
          <div class="incident-date">September 2026</div>
          <div class="incident-content">
            <span class="incident-status text-emerald">&bull; Completed Scheduled Upgrade</span>
            <p class="incident-text">Successfully deployed Discord Gateway v10 sharded worker pool and TLS JA4 fingerprint randomized ciphers without service interruption.</p>
          </div>
        </div>
      </div>

      <!-- Navigation Actions -->
      <div class="status-actions reveal" style="--delay: 250ms;">
        <a href="/" class="btn btn--primary" data-cursor-hover>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Return to Homepage</span>
        </a>
        <a href="/#contact" class="btn btn--secondary" data-cursor-hover>
          <span>Request Custom Bot Deployment</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Live Node Ping Probe Trigger
  const refreshBtn = document.getElementById('btn-refresh-nodes');
  const refreshLabel = document.getElementById('refresh-label');
  const nodeCards = document.querySelectorAll('.status-node-card');
  const inspectBarText = document.getElementById('status-inspect-text');

  refreshBtn?.addEventListener('click', () => {
    if (refreshLabel) refreshLabel.textContent = 'Probing 64 Nodes...';

    nodeCards.forEach((card) => {
      const pingEl = card.querySelector('[data-ping-el]');
      const basePing = parseInt(card.getAttribute('data-base-ping') || '20', 10);
      const variance = Math.floor(Math.random() * 7) - 3;
      const newPing = Math.max(12, basePing + variance);

      if (pingEl) {
        pingEl.textContent = '...';
        setTimeout(() => {
          pingEl.textContent = `${newPing}ms`;
        }, 300 + Math.random() * 400);
      }
    });

    setTimeout(() => {
      if (refreshLabel) refreshLabel.textContent = 'Execute Live Ping Probe';
      if (inspectBarText) {
        inspectBarText.textContent = 'Live probe complete: All 64 nodes responding with nominal TLS handshake & 0 packet loss.';
      }
    }, 1000);
  });

  // Node Click Handlers
  nodeCards.forEach((card) => {
    card.addEventListener('click', () => {
      const region = card.getAttribute('data-region');
      const ip = card.getAttribute('data-ip');
      const pingEl = card.querySelector('[data-ping-el]');
      const pingVal = pingEl ? pingEl.textContent : '22ms';

      if (inspectBarText) {
        inspectBarText.textContent = `INSPECTING: ${region} &bull; SOCKS5 Proxy: ${ip} &bull; Latency: ${pingVal} &bull; TLS Handshake: TLSv1.3 JA3_RANDOMIZED &bull; Status: NOMINAL`;
      }

      nodeCards.forEach((c) => c.classList.remove('is-selected'));
      card.classList.add('is-selected');
    });
  });
</script>

<style>
  .status-page {
    padding: calc(80px + var(--space-12)) 0 var(--space-20);
    min-height: 90vh;
  }

  .status-container {
    max-width: 1040px;
    margin: 0 auto;
  }

  .status-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .status-title {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 800;
    color: #F8FAFC;
    letter-spacing: var(--tracking-tight);
    margin: var(--space-4) 0 var(--space-2);
  }

  .status-subtitle {
    font-size: var(--size-body-lg);
    color: var(--color-text-secondary);
    max-width: 65ch;
    margin: 0 auto var(--space-8);
    line-height: var(--leading-relaxed);
  }

  /* Global Banner */
  .global-status-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5) var(--space-8);
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.35);
    border-radius: var(--radius-2xl);
    text-align: left;
    gap: var(--space-6);
  }

  .global-status-left {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .global-radar-beacon {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: #10B981;
    box-shadow: 0 0 14px #10B981;
    animation: statusPulse 1.8s infinite;
    flex-shrink: 0;
  }

  .global-status-heading {
    font-size: 1.35rem;
    font-weight: 800;
    color: #FFFFFF;
    margin: 0;
  }

  .global-status-sub {
    font-family: var(--font-mono);
    font-size: 11px;
    color: #A7F3D0;
    margin: 2px 0 0;
  }

  .global-status-uptime {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
  }

  .uptime-val {
    font-family: var(--font-mono);
    font-size: 1.8rem;
    font-weight: 800;
    color: #10B981;
    line-height: 1;
  }

  .uptime-label {
    font-size: 10px;
    color: #94A3B8;
  }

  /* Summary Grid */
  .cluster-summary-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  .summary-card {
    background: rgba(19, 27, 46, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .summary-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    color: #94A3B8;
  }

  .summary-val {
    font-family: var(--font-mono);
    font-size: 13.5px;
    font-weight: 800;
  }

  .summary-meta {
    font-size: 10px;
    color: #64748B;
  }

  /* Node Map Section */
  .node-map-section {
    background: rgba(14, 20, 34, 0.95);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    margin-bottom: var(--space-12);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
  }

  .node-map-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    background: rgba(10, 14, 26, 0.98);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .node-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .map-dots {
    display: flex;
    gap: 6px;
  }

  .node-map-title {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: #94A3B8;
  }

  .node-refresh-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.35);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: #C7D2FE;
    cursor: pointer;
    transition: all var(--duration-fast) ease;
  }

  .node-refresh-btn:hover {
    background: #6366F1;
    color: #FFFFFF;
    border-color: #6366F1;
  }

  .nodes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    padding: var(--space-6);
  }

  .status-node-card {
    background: rgba(19, 27, 46, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    cursor: pointer;
    transition: all var(--duration-fast) ease;
  }

  .status-node-card:hover,
  .status-node-card.is-selected {
    transform: translateY(-2px);
    border-color: #6366F1;
    background: rgba(25, 36, 62, 0.95);
    box-shadow: 0 8px 24px rgba(99, 102, 241, 0.25);
  }

  .node-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .node-badge-id {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    color: #94A3B8;
  }

  .node-beacon-green {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 6px #10B981;
    animation: statusPulse 2s infinite;
  }

  .node-region-title {
    font-size: 13px;
    font-weight: 700;
    color: #F8FAFC;
    margin: 0;
  }

  .node-role-text {
    font-size: 10px;
    color: #94A3B8;
    line-height: 1.3;
    margin: 0;
  }

  .node-stats-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
    padding-top: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .node-ping-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: #10B981;
  }

  .node-health-tag {
    font-family: var(--font-mono);
    font-size: 8.5px;
    color: #64748B;
  }

  .node-inspect-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    background: rgba(10, 14, 26, 0.98);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: #CBD5E1;
  }

  .inspect-beacon {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #6366F1;
    box-shadow: 0 0 6px #6366F1;
    flex-shrink: 0;
  }

  /* Incident Section */
  .incident-history-section {
    background: rgba(19, 27, 46, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .incident-history-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #F8FAFC;
    margin: 0 0 var(--space-6);
  }

  .incident-card {
    display: flex;
    gap: var(--space-6);
    padding: var(--space-4) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .incident-card:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .incident-date {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: #94A3B8;
    min-width: 120px;
  }

  .incident-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .incident-status {
    font-size: 12px;
    font-weight: 700;
  }

  .incident-text {
    font-size: var(--size-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Actions */
  .status-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* Responsive */
  @media (max-width: 968px) {
    .cluster-summary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .nodes-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .global-status-banner {
      flex-direction: column;
      align-items: flex-start;
    }
    .global-status-uptime {
      align-items: flex-start;
    }
  }

  @media (max-width: 640px) {
    .cluster-summary-grid {
      grid-template-columns: 1fr;
    }
    .nodes-grid {
      grid-template-columns: 1fr;
    }
    .incident-card {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
