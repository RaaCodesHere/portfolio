    font-size: 11px;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .hero-stat-divider {
    width: 1px;
    height: 28px;
    background: rgba(255, 255, 255, 0.08);
  }

  /* ---------- Right Column: Code Card ---------- */
  .hero-visual {
    position: relative;
    opacity: 0;
    animation: heroSlideUp 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
  }

