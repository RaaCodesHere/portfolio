---
/* RaaSki — hero section.
   1. Dynamic animated SVG constellation network with flowing light beams & floating ambient glow.
   2. Fresh Electric Cyan & Radiant Emerald gradient palette.
   3. Exact requested headline with smooth staggered text reveal & gradient shimmer.
   4. Multi-file Python architecture card with tabs & working copy.
   5. Generous padding-top to prevent any header overlap. */
import { defaultPortfolioData } from '../data/portfolioData';

const { hero } = defaultPortfolioData;

const codeTabs = [
  {
    id: 'pos',
    filename: 'pos_inventory_bridge.py',
    tag: 'FastAPI + Celery',
    code: `import hmac, hashlib
from fastapi import FastAPI, Header, HTTPException
from core.queues import celery_app
from core.database import atomic_inventory_lock

app = FastAPI(title="OmniVendor POS Gateway", version="3.2.0")

@app.post("/webhooks/clover-sync")
async def sync_pos_transaction(payload: dict, x_signature: str = Header()):
    # Verify cryptographic HMAC signature from register hardware
    expected = hmac.new(SECRET_KEY, str(payload).encode(), hashlib.sha256).hexdigest()
    if not hmac.compare_digest(expected, x_signature):
        raise HTTPException(status_code=401, detail="Invalid HMAC signature")

    # Atomic multi-channel stock lock across physical and digital storefronts
    async with atomic_inventory_lock(payload["sku"]):
        task = celery_app.send_task("reconcile_stock", args=[payload["sku"], -1])
        return {"status": "ENQUEUED", "task_id": task.id, "latency_ms": 14}`
  },
  {
    id: 'stealth',
    filename: 'stealth_session.py',
    tag: 'Playwright + JA4',
    code: `from playwright.async_api import async_playwright
from core.tls import JA4Profile, ResidentialMesh

class StealthEngine:
    """Anti-detection browser cluster evading Turnstile & DataDome."""
    def __init__(self):
        self.proxies = ResidentialMesh(protocol="socks5", max_ping=35)

    async def fetch_protected_feed(self, target_url: str) -> dict:
        endpoint = await self.proxies.get_healthy_endpoint()
        async with async_playwright() as pw:
            browser = await pw.chromium.launch(
                proxy={"server": endpoint.url},
                args=["--disable-blink-features=AutomationControlled"]
            )
            ctx = await JA4Profile.apply_camoufox(browser)
            page = await ctx.new_page()
            await page.goto(target_url, wait_until="networkidle")
            return await page.evaluate("() => window.__APP_DATA__")`
  },
  {
    id: 'gateway',
    filename: 'event_gateway.py',
    tag: 'AsyncIO + Token Bucket',
    code: `import asyncio
from core.defense import HeuristicEngine, RateLimiter
from core.audit import WALSnapshotBus

class SystemEventGateway:
    """High-concurrency microservice event dispatcher & defense engine."""
    def __init__(self):
        self.heuristics = HeuristicEngine(window=3.0, threshold=12)
        self.limiter = RateLimiter(capacity=50, refill_rate=25.0)
        self.wal_bus = WALSnapshotBus(storage_mode="sqlite_wal")

    async def dispatch_event(self, event_id: str, payload: dict):
        if not await self.limiter.acquire(tokens=1):
            await self.wal_bus.record_burst_overflow(event_id)
            return {"status": "RATE_LIMITED", "retry_after_ms": 18}
        return await self.heuristics.process_atomic(payload)`
  }
];
---

<section class="hero" aria-label="Introduction">
  <!-- Interactive Bot Network Matrix with Flowing Light Beams & New Gradient -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-gradient"></div>
    <div class="hero-grid-pattern"></div>
    <div class="hero-vignette"></div>

    <!-- Animated Data Flow SVG Network with Flowing Light Beams -->
    <svg class="bot-network-svg" viewBox="0 0 1400 900" fill="none" preserveAspectRatio="xMidYMid slice">
      <defs>
        <!-- Particle & Path Glow Filter -->
        <filter id="lightGlow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="4" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>

        <!-- Fresh Cyan & Emerald Vector Gradients -->
        <linearGradient id="traceGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#06B6D4" stop-opacity="0.4" />
          <stop offset="50%" stop-color="#3B82F6" stop-opacity="0.3" />
          <stop offset="100%" stop-color="#10B981" stop-opacity="0.4" />
        </linearGradient>

        <linearGradient id="traceGrad2" x1="100%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#10B981" stop-opacity="0.35" />
          <stop offset="50%" stop-color="#06B6D4" stop-opacity="0.25" />
          <stop offset="100%" stop-color="#3B82F6" stop-opacity="0.35" />
        </linearGradient>

        <!-- Motion Paths for Flowing Light Particles -->
        <path id="path_flow_1" d="M 120,160 L 380,120 L 720,180 L 1040,140 L 1280,220" />
        <path id="path_flow_2" d="M 1280,220 L 1120,460 L 820,380 L 540,480 L 180,440" />
        <path id="path_flow_3" d="M 180,440 L 260,720 L 640,660 L 980,740 L 1320,680" />
        <path id="path_cross_1" d="M 380,120 L 540,480 L 640,660" />
        <path id="path_cross_2" d="M 720,180 L 820,380 L 980,740" />
        <path id="path_cross_3" d="M 1040,140 L 1120,460 L 1320,680" />
      </defs>

      <!-- Network Circuit Lines Connecting Nodes -->
      <use href="#path_flow_1" stroke="url(#traceGrad1)" stroke-width="1.5" />
      <use href="#path_flow_2" stroke="url(#traceGrad2)" stroke-width="1.5" />
      <use href="#path_flow_3" stroke="url(#traceGrad1)" stroke-width="1.5" />
      <use href="#path_cross_1" stroke="url(#traceGrad2)" stroke-width="1.2" stroke-dasharray="3 5" />
      <use href="#path_cross_2" stroke="url(#traceGrad1)" stroke-width="1.2" stroke-dasharray="3 5" />
      <use href="#path_cross_3" stroke="url(#traceGrad2)" stroke-width="1.2" stroke-dasharray="3 5" />

      <!-- Network Constellation Nodes with Subtle Glow -->
      <g class="net-node" transform="translate(120, 160)"><circle r="8" fill="#06B6D4" fill-opacity="0.2" /><circle r="4" fill="#06B6D4" /><circle r="1.5" fill="#FFFFFF" /></g>
      <g class="net-node" transform="translate(380, 120)"><circle r="10" fill="#10B981" fill-opacity="0.25" /><circle r="4.5" fill="#10B981" /><circle r="1.8" fill="#FFFFFF" /></g>
      <g class="net-node" transform="translate(720, 180)"><circle r="12" fill="#06B6D4" fill-opacity="0.2" /><circle r="5" fill="#06B6D4" /><circle r="2" fill="#FFFFFF" /></g>
      <g class="net-node" transform="translate(1040, 140)"><circle r="10" fill="#3B82F6" fill-opacity="0.25" /><circle r="4.5" fill="#3B82F6" /><circle r="2" fill="#FFFFFF" /></g>
      <g class="net-node" transform="translate(1280, 220)"><circle r="9" fill="#10B981" fill-opacity="0.2" /><circle r="4" fill="#10B981" /><circle r="1.5" fill="#FFFFFF" /></g>

      <g class="net-node" transform="translate(180, 440)"><circle r="9" fill="#3B82F6" fill-opacity="0.2" /><circle r="4" fill="#3B82F6" /><circle r="1.5" fill="#FFFFFF" /></g>
      <g class="net-node" transform="translate(540, 480)"><circle r="11" fill="#06B6D4" fill-opacity="0.22" /><circle r="4.5" fill="#06B6D4" /><circle r="1.8" fill="#FFFFFF" /></g>
      <g class="net-node" transform="translate(820, 380)"><circle r="13" fill="#10B981" fill-opacity="0.25" /><circle r="5.5" fill="#10B981" /><circle r="2.2" fill="#FFFFFF" /></g>
      <g class="net-node" transform="translate(1120, 460)"><circle r="10" fill="#06B6D4" fill-opacity="0.2" /><circle r="4" fill="#06B6D4" /><circle r="1.5" fill="#FFFFFF" /></g>

      <g class="net-node" transform="translate(260, 720)"><circle r="10" fill="#10B981" fill-opacity="0.2" /><circle r="4.5" fill="#10B981" /><circle r="1.8" fill="#FFFFFF" /></g>
      <g class="net-node" transform="translate(640, 660)"><circle r="12" fill="#06B6D4" fill-opacity="0.22" /><circle r="5" fill="#06B6D4" /><circle r="2" fill="#FFFFFF" /></g>
      <g class="net-node" transform="translate(980, 740)"><circle r="12" fill="#3B82F6" fill-opacity="0.25" /><circle r="5" fill="#3B82F6" /><circle r="2" fill="#FFFFFF" /></g>
      <g class="net-node" transform="translate(1320, 680)"><circle r="9" fill="#10B981" fill-opacity="0.2" /><circle r="4" fill="#10B981" /><circle r="1.5" fill="#FFFFFF" /></g>

      <!-- Flowing Light Particles along Paths (Hardware Accelerated) -->
      <circle r="4" fill="#38BDF8" filter="url(#lightGlow)">
        <animateMotion dur="5.2s" repeatCount="indefinite"><mpath href="#path_flow_1" /></animateMotion>
      </circle>
      <circle r="4" fill="#34D399" filter="url(#lightGlow)">
        <animateMotion dur="6.0s" repeatCount="indefinite"><mpath href="#path_flow_2" /></animateMotion>
      </circle>
      <circle r="4" fill="#06B6D4" filter="url(#lightGlow)">
        <animateMotion dur="5.6s" repeatCount="indefinite"><mpath href="#path_flow_3" /></animateMotion>
      </circle>
      <circle r="3.5" fill="#6EE7B7" filter="url(#lightGlow)">
        <animateMotion dur="4.2s" repeatCount="indefinite"><mpath href="#path_cross_1" /></animateMotion>
      </circle>
      <circle r="4" fill="#38BDF8" filter="url(#lightGlow)">
        <animateMotion dur="4.8s" repeatCount="indefinite"><mpath href="#path_cross_2" /></animateMotion>
      </circle>
      <circle r="3.5" fill="#10B981" filter="url(#lightGlow)">
        <animateMotion dur="4.4s" repeatCount="indefinite"><mpath href="#path_cross_3" /></animateMotion>
      </circle>
    </svg>

    <!-- Peripheral Ambient Glowing Orbs with Smooth Floating Animation -->
    <div class="hero-orb hero-orb--cyan"></div>
    <div class="hero-orb hero-orb--emerald"></div>
    <div class="hero-orb hero-orb--blue"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <!-- Senior Backend Architect Badge -->
      <div class="hero-badge anim-badge">
        <span class="hero-badge-dot"></span>
        <span class="hero-badge-text">{hero.badge}</span>
      </div>

      <!-- Hero Headline with Smooth Line Stagger -->
      <h1 class="hero-title">
        <span class="title-line title-line--1">{hero.titleLine1}</span>
        {hero.titleLine2 && <span class="title-line title-line--2">{hero.titleLine2}</span>}
        <span class="title-line title-line--3 title-accent">{hero.titleAccent}</span>
      </h1>

      <!-- Hero Subtitle -->
      <p class="hero-subtitle anim-subtitle">
        {hero.subtitle}
      </p>

      <!-- Upgraded Multi-Action Buttons -->
      <div class="hero-actions anim-actions">
        <a href="#projects" class="btn btn--primary" data-cursor-hover>
          <span>Explore Systems</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
        <a href="#contact" class="btn btn--secondary" data-cursor-hover title="Direct contact & fast response">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <span>Get in Touch</span>
        </a>
      </div>

      <!-- Grounded Stats Row -->
      <div class="hero-stats anim-stats">
        {hero.stats.map((stat, idx) => (
          <>
            <div class="hero-stat">
              <span class="hero-stat-number">{stat.number}</span>
              <span class="hero-stat-label">{stat.label}</span>
            </div>
            {idx < hero.stats.length - 1 && <div class="hero-stat-divider"></div>}
          </>
        ))}
      </div>
    </div>

    <!-- Right Column: Authentic Python Architecture Card -->
    <div class="hero-visual">
      <div class="architecture-code-card" id="hero-code-card">
        <!-- Card Top Window Bar with Switchable Tabs -->
        <div class="card-tabs-header">
          <div class="window-controls">
            <span class="w-dot w-dot--red"></span>
            <span class="w-dot w-dot--yellow"></span>
            <span class="w-dot w-dot--green"></span>
          </div>

          <div class="code-file-tabs" role="tablist" aria-label="Architecture Code Tabs">
            {codeTabs.map((tab, idx) => (
              <button
                class={`tab-pill-btn ${idx === 0 ? 'is-active' : ''}`}
                data-tab-target={tab.id}
                type="button"
                role="tab"
                aria-selected={idx === 0 ? 'true' : 'false'}
              >
                <span>{tab.filename}</span>
              </button>
            ))}
          </div>

          <button id="btn-copy-hero-code" class="btn-copy-code" type="button" title="Copy Python code">
            <svg id="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-label">Copy</span>
          </button>
        </div>

        <!-- Tab Panes -->
        <div class="code-panes-body">
          {codeTabs.map((tab, idx) => {
            const lines = tab.code.split('\n');
            return (
              <div
                class={`code-pane ${idx === 0 ? 'is-active' : ''}`}
                id={`pane-${tab.id}`}
                role="tabpanel"
              >
                <div class="pane-meta-strip">
                  <span class="meta-tag">{tab.tag}</span>
                  <span class="meta-info">Production Ready &bull; Asynchronous</span>
                </div>
                <pre class="pane-pre"><code>{lines.map((line, lIdx) => (
                  <span class="pane-line"><span class="pane-num">{(lIdx + 1).toString().padStart(2, '0')}</span><span class="pane-code">{line}</span></span>
                ))}</code></pre>
              </div>
            );
          })}
        </div>

        <!-- Card Footer Status -->
        <div class="card-footer-strip">
          <div class="footer-status-indicator">
            <span class="indicator-dot"></span>
            <span class="indicator-text">Production Node active &bull; Latency: 18ms</span>
          </div>
          <span class="footer-lang">Python 3.12</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Lightweight Interactive Script for Code Tabs & Copy -->
<script>
  const tabButtons = document.querySelectorAll('.tab-pill-btn');
  const codePanes = document.querySelectorAll('.code-pane');
  const copyBtn = document.getElementById('btn-copy-hero-code');
  const copyLabel = document.getElementById('copy-label');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab-target');
      tabButtons.forEach((b) => {
        b.classList.remove('is-active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');

      codePanes.forEach((pane) => {
        pane.classList.toggle('is-active', pane.id === `pane-${target}`);
      });
    });
  });

  copyBtn?.addEventListener('click', async () => {
    const activePane = document.querySelector('.code-pane.is-active');
    if (!activePane) return;
    const textLines = Array.from(activePane.querySelectorAll('.pane-code')).map(el => el.textContent || '').join('\n');
    try {
      await navigator.clipboard.writeText(textLines);
      if (copyLabel) copyLabel.textContent = 'Copied!';
      setTimeout(() => {
        if (copyLabel) copyLabel.textContent = 'Copy';
      }, 2000);
    } catch {
      // Fallback
    }
  });
</script>

<style>
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    /* Generous top padding prevents ANY overlap from fixed header (84px + 36px) */
    padding-top: calc(var(--header-height, 84px) + 2.5rem);
    padding-bottom: var(--space-16);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 18% 30%, rgba(6, 182, 212, 0.14) 0%, transparent 55%),
                radial-gradient(circle at 82% 70%, rgba(16, 185, 129, 0.1) 0%, transparent 50%),
                #0B0F19;
  }

  .hero-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.7;
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 35%, rgba(11, 15, 25, 0.88) 100%);
  }

  /* Animated Circuit SVG */
  .bot-network-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.65;
    pointer-events: none;
  }

  /* Floating Ambient Glow Orbs */
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.45;
    animation: floatOrb 12s ease-in-out infinite alternate;
  }

  .hero-orb--cyan {
    top: 15%;
    right: 8%;
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.3) 0%, transparent 70%);
