    0% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(25px, -20px) scale(1.08);
    }
    100% {
      transform: translate(-20px, 20px) scale(0.95);
    }
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.12fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  /* ---------- Left Column Content ---------- */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Badge Animation */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(6, 182, 212, 0.1);
    border: 1px solid rgba(6, 182, 212, 0.3);
