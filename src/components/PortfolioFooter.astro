---
/* RaaSki — footer with copyright, secondary navigation, and back-to-top button.
   All icons are inline SVGs. */
---

<footer class="footer" aria-label="Site footer">
  <div class="container">
    <div class="footer-top">
      <!-- Brand column -->
      <div class="footer-brand">
        <a class="footer-wordmark" href="/" aria-label="RaaSki Home">
          <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true" fill="none">
            <defs>
              <linearGradient id="ft-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#6366F1" />
                <stop offset="50%" stop-color="#8B5CF6" />
                <stop offset="100%" stop-color="#06B6D4" />
              </linearGradient>
            </defs>
            <rect width="32" height="32" rx="8" fill="#131B2E" />
            <polygon points="16,4 27,10 27,22 16,28 5,22 5,10" stroke="url(#ft-grad)" stroke-width="1.8" fill="rgba(11, 15, 25, 0.9)" />
            <circle cx="16" cy="16" r="3.5" fill="#6366F1" />
            <circle cx="16" cy="16" r="1.5" fill="#FFFFFF" />
          </svg>
          <span>RaaSki</span>
        </a>
        <p class="footer-tagline">Autonomous Discord bot frameworks, commercial vendor POS pipelines, and stealth OSINT swarms.</p>
      </div>

      <!-- Navigation columns -->
      <div class="footer-nav-group">
        <div class="footer-nav-col">
          <h4 class="footer-nav-heading">Navigation</h4>
          <nav aria-label="Footer navigation">
            <a class="footer-link" href="/#about">About</a>
            <a class="footer-link" href="/#projects">Projects</a>
            <a class="footer-link" href="/#solutions">Solutions</a>
            <a class="footer-link" href="/status">Cluster Status</a>
            <a class="footer-link" href="/#contact">Contact</a>
          </nav>
        </div>

        <div class="footer-nav-col">
          <h4 class="footer-nav-heading">Connect</h4>
          <nav aria-label="Social links">
            <a class="footer-link" href="https://github.com/RaaCodesHere" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a class="footer-link" href="https://www.linkedin.com/in/samyog-dhakal/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a class="footer-link" href="https://discord.com/users/1105760622462914623" target="_blank" rel="noopener noreferrer">Discord</a>
            <a class="footer-link" href="mailto:contact@codewithraa.me">Email</a>
          </nav>
        </div>

        <div class="footer-nav-col">
          <h4 class="footer-nav-heading">Compliance</h4>
          <nav aria-label="Legal and status">
            <a class="footer-link" href="/terms">Terms of Service</a>
            <a class="footer-link" href="/privacy">Privacy Policy</a>
            <a class="footer-link" href="/status">Status / Node Map</a>
          </nav>
        </div>
      </div>
    </div>

    <hr class="footer-rule" aria-hidden="true" />

    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; <span id="footer-year"></span> Samyog Dhakal (RaaSki). All rights reserved.
      </p>

      <p class="footer-built">
        Engineered for High-Concurrency Discord Communities &amp; Retail Vendors
      </p>
    </div>
  </div>

  <!-- Back to top button -->
  <button
    class="back-to-top"
    id="back-to-top"
    type="button"
    aria-label="Back to top"
    title="Back to top"
    data-cursor-hover
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="18 15 12 9 6 15" />
    </svg>
  </button>
</footer>

<script>
  // Set current year
  const yearEl = document.getElementById('footer-year');
  if (yearEl) {
    yearEl.textContent = new Date().getFullYear().toString();
  }
</script>

<style>
  .footer {
    position: relative;
    background: var(--color-bg-elevated);
    border-top: 1px solid var(--color-border);
    padding: var(--space-16) 0 var(--space-8);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-16);
    margin-bottom: var(--space-8);
  }

  /* ---------- Brand ---------- */
  .footer-wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .footer-wordmark:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .footer-tagline {
    font-size: var(--size-sm);
    color: var(--color-text-tertiary);
    max-width: 36ch;
    line-height: var(--leading-body);
  }

  /* ---------- Navigation ---------- */
  .footer-nav-group {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .footer-nav-heading {
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-4);
  }

  .footer-nav-col nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-link {
    font-size: var(--size-sm);
    color: var(--color-text-secondary);
    transition: color var(--duration-normal) ease;
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  .footer-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* ---------- Bottom ---------- */
  .footer-rule {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0 0 var(--space-6) 0;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-copyright {
    font-size: var(--size-sm);
    color: var(--color-text-muted);
  }

  .footer-built {
    font-size: var(--size-sm);
    color: var(--color-text-muted);
  }

  /* ---------- Back to top ---------- */
  .back-to-top {
    position: fixed;
    bottom: var(--space-8);
    right: var(--space-8);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: all var(--duration-normal) var(--ease-out-expo);
    z-index: 50;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .back-to-top:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
    transform: translateY(-2px);
  }

  .back-to-top:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .back-to-top {
      bottom: max(var(--space-4), calc(var(--space-4) + env(safe-area-inset-bottom)));
      right: max(var(--space-4), calc(var(--space-4) + env(safe-area-inset-right)));
    }
  }
</style>
