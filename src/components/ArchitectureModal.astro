---
/* RaaSki — Architecture Deep-Dive Blueprint Modal.
   Provides rich technical blueprints, latency profiles, stack specs,
   and interactive actions (Inquire with Spec, Copy Architecture Brief).
   Uses modern HTML5 <dialog> with zero heavy libraries. */
---

<dialog id="architecture-dialog" class="arch-dialog" aria-labelledby="arch-dialog-title" aria-modal="true">
  <div class="arch-modal-box">
    <!-- Top Bar with Window Controls & Close Button -->
    <div class="arch-modal-topbar">
      <div class="arch-topbar-left">
        <span class="w-dot w-dot--red" id="btn-close-arch-dot"></span>
        <span class="w-dot w-dot--yellow"></span>
        <span class="w-dot w-dot--green"></span>
        <span class="arch-topbar-tag">SYSTEM ARCHITECTURE SPECIFICATION</span>
      </div>
      <button type="button" class="btn-arch-close" id="btn-close-arch" aria-label="Close architecture modal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Modal Content Body -->
    <div class="arch-modal-body">
      <!-- Header Info -->
      <div class="arch-header-section">
        <div class="arch-badge-row">
          <span class="arch-badge-category" id="arch-modal-category">RETAIL POS AUTOMATION</span>
          <span class="arch-badge-sla" id="arch-modal-sla">99.9% UPTIME SLA</span>
        </div>
        <h3 class="arch-title" id="arch-dialog-title">OmniVendor Bridge — Real-Life POS &amp; Multi-Channel Pipeline</h3>
        <p class="arch-subtitle" id="arch-modal-subtitle">
          Cryptographically signed event-driven integration pipeline synchronizing physical POS hardware registers with digital store channels and Stripe settlement.
        </p>
      </div>

      <!-- Live Architecture Blueprint (ASCII & Flow Cards) -->
      <div class="arch-blueprint-section">
        <div class="blueprint-header-bar">
          <span class="blueprint-label">DATA PIPELINE &amp; CONCURRENCY BLUEPRINT</span>
          <span class="blueprint-latency" id="arch-modal-latency">P99: &lt; 24ms</span>
        </div>
        <div class="blueprint-flow-grid">
          <div class="flow-step">
            <span class="flow-step-num">01. INGESTION</span>
            <strong class="flow-step-name" id="arch-flow-ingest">Hardware Register Webhook</strong>
            <p class="flow-step-desc" id="arch-flow-ingest-desc">Inbound Clover/Square POS checkout payload via HTTPS.</p>
          </div>
          <div class="flow-arrow" aria-hidden="true">→</div>
          <div class="flow-step">
            <span class="flow-step-num">02. VERIFICATION</span>
            <strong class="flow-step-name" id="arch-flow-verify">HMAC-SHA256 Signing</strong>
            <p class="flow-step-desc" id="arch-flow-verify-desc">Header cryptographic validation; zero plain token disk storage.</p>
          </div>
          <div class="flow-arrow" aria-hidden="true">→</div>
          <div class="flow-step">
            <span class="flow-step-num">03. QUEUE &amp; LOCK</span>
            <strong class="flow-step-name" id="arch-flow-queue">Celery + ACID Row Lock</strong>
            <p class="flow-step-desc" id="arch-flow-queue-desc">Atomic database state lock prevents stock race conditions.</p>
          </div>
          <div class="flow-arrow" aria-hidden="true">→</div>
          <div class="flow-step">
            <span class="flow-step-num">04. DISPATCH</span>
            <strong class="flow-step-name" id="arch-flow-dispatch">Multi-Store Sync &amp; Receipt</strong>
            <p class="flow-step-desc" id="arch-flow-dispatch-desc">Instant inventory reconciliation &amp; PDF invoice push.</p>
          </div>
        </div>
      </div>

      <!-- Performance & Engineering Metrics Matrix -->
      <div class="arch-specs-grid">
        <div class="arch-spec-card">
          <span class="spec-label">Concurrency Model</span>
          <strong class="spec-value" id="arch-spec-concurrency">Python 3.12 (asyncio + Celery)</strong>
          <span class="spec-detail">Non-blocking event loop &amp; distributed task workers</span>
        </div>
        <div class="arch-spec-card">
          <span class="spec-label">Security &amp; Auth</span>
          <strong class="spec-value" id="arch-spec-security">HMAC-SHA256 + Ephemeral Mem</strong>
          <span class="spec-detail">Zero token serialization to disk or logs</span>
        </div>
        <div class="arch-spec-card">
          <span class="spec-label">State Persistence</span>
          <strong class="spec-value" id="arch-spec-storage">PostgreSQL &amp; SQLite WAL</strong>
          <span class="spec-detail">ACID transactions with continuous snapshot bus</span>
        </div>
        <div class="arch-spec-card">
          <span class="spec-label">Burst Protection</span>
          <strong class="spec-value" id="arch-spec-rate">Token-Bucket Rate Limiter</strong>
          <span class="spec-detail">Smooths 50k+ req/min spikes with 0 loss</span>
        </div>
      </div>

      <!-- Action Row -->
      <div class="arch-action-footer">
        <div class="arch-footer-left">
          <button type="button" class="btn btn--primary" id="btn-inquire-with-spec">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>Inquire About This Project</span>
          </button>
          <button type="button" class="btn btn--secondary" id="btn-copy-arch-spec">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-arch-label">Copy Technical Brief</span>
          </button>
        </div>
        <span class="arch-confidential-note">Production Architecture Brief</span>
      </div>
    </div>
  </div>
</dialog>

<style>
  .arch-dialog {
    padding: 0;
    border: none;
    background: transparent;
    max-width: 860px;
    width: calc(100% - 2rem);
    margin: auto;
    color: var(--color-text-primary);
    overflow: visible;
  }

  .arch-dialog::backdrop {
    background: rgba(11, 15, 25, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .arch-modal-box {
    background: #0F1626;
    border: 1px solid rgba(6, 182, 212, 0.3);
    border-radius: var(--radius-2xl);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.7), 0 0 40px rgba(6, 182, 212, 0.15);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: archModalPop 0.28s var(--ease-out-expo) forwards;
  }

  @keyframes archModalPop {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(12px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Top Bar */
  .arch-modal-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    background: rgba(14, 20, 34, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .arch-topbar-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .w-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: inline-block;
  }

  .w-dot--red { background: #EF4444; cursor: pointer; }
  .w-dot--yellow { background: #F59E0B; }
  .w-dot--green { background: #10B981; }

  .arch-topbar-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: #38BDF8;
    letter-spacing: 0.8px;
    margin-left: 8px;
  }

  .btn-arch-close {
    background: transparent;
    border: none;
    color: var(--color-text-tertiary);
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--duration-fast) ease;
  }

  .btn-arch-close:hover {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.08);
  }

  /* Modal Body */
  .arch-modal-body {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Header Section */
  .arch-header-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .arch-badge-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .arch-badge-category {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: #06B6D4;
    background: rgba(6, 182, 212, 0.12);
    border: 1px solid rgba(6, 182, 212, 0.28);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .arch-badge-sla {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: #10B981;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.28);
    padding: 3px 10px;
    border-radius: var(--radius-full);
  }

  .arch-title {
    font-size: clamp(1.25rem, 2.2vw, 1.65rem);
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: var(--leading-tight);
    margin: 4px 0 0;
  }

  .arch-subtitle {
    font-size: var(--size-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Blueprint Grid */
  .arch-blueprint-section {
    background: rgba(14, 20, 34, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .blueprint-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 8px;
  }

  .blueprint-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: #94A3B8;
    letter-spacing: 0.8px;
  }

  .blueprint-latency {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: #10B981;
    background: rgba(16, 185, 129, 0.12);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .blueprint-flow-grid {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .flow-step {
    flex: 1;
    min-width: 140px;
    background: rgba(19, 27, 46, 0.8);
    border: 1px solid rgba(6, 182, 212, 0.2);
    border-radius: var(--radius-md);
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .flow-step-num {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    color: #38BDF8;
    letter-spacing: 0.5px;
  }

  .flow-step-name {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.25;
  }

  .flow-step-desc {
    font-size: 10px;
    color: var(--color-text-tertiary);
    line-height: 1.35;
    margin: 0;
  }

  .flow-arrow {
    font-size: 14px;
    color: #06B6D4;
    font-weight: bold;
    flex-shrink: 0;
  }

  /* Specs Grid */
  .arch-specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .arch-spec-card {
    background: rgba(19, 27, 46, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-lg);
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .spec-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: #64748B;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .spec-value {
    font-size: 13px;
    font-weight: 700;
    color: #F1F5F9;
  }

  .spec-detail {
    font-size: 11px;
    color: #94A3B8;
  }

  /* Footer Action */
  .arch-action-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
  }

  .arch-footer-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .arch-confidential-note {
    font-family: var(--font-mono);
    font-size: 11px;
    color: #64748B;
  }

  @media (max-width: 768px) {
    .blueprint-flow-grid {
      flex-direction: column;
      align-items: stretch;
    }
    .flow-arrow {
      text-align: center;
      transform: rotate(90deg);
      margin: -2px 0;
    }
    .arch-specs-grid {
      grid-template-columns: 1fr;
    }
    .arch-action-footer {
      flex-direction: column;
      align-items: stretch;
    }
    .arch-footer-left {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
