---
/* RaaSki — Quick Connect & Direct Channels Modal.
   Upgrades "Get in Touch" into an instant-access hub with 1-click
   email copy, Discord profile launch, LinkedIn portal, and form jump.
   Uses native HTML5 <dialog>. */
---

<dialog id="quick-connect-dialog" class="connect-dialog" aria-labelledby="connect-dialog-title" aria-modal="true">
  <div class="connect-modal-box">
    <!-- Top Bar -->
    <div class="connect-modal-topbar">
      <div class="connect-topbar-left">
        <span class="w-dot w-dot--red" id="btn-close-connect-dot"></span>
        <span class="w-dot w-dot--yellow"></span>
        <span class="w-dot w-dot--green"></span>
        <span class="connect-topbar-tag">DIRECT TECHNICAL CHANNELS</span>
      </div>
      <button type="button" class="btn-connect-close" id="btn-close-connect" aria-label="Close connect modal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Modal Content -->
    <div class="connect-modal-body">
      <div class="connect-header-area">
        <div class="connect-status-chip">
          <span class="status-pulse-dot"></span>
          <span>Kathmandu, Nepal (UTC +5:45) &bull; Available for Architecture &amp; Contracts</span>
        </div>
        <h3 class="connect-title" id="connect-dialog-title">Get in Touch with Samyog (RaaSki)</h3>
        <p class="connect-desc">
          Choose your preferred direct communication channel for architecture consultations, project estimates, or urgent pipeline support.
        </p>
      </div>

      <!-- Quick Action Cards Grid -->
      <div class="connect-channels-grid">
        <!-- Channel 1: Email -->
        <div class="channel-card">
          <div class="channel-card-icon channel-card-icon--cyan">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div class="channel-card-info">
            <span class="channel-label">Direct Technical Email</span>
            <strong class="channel-value">contact@codewithraa.me</strong>
            <span class="channel-sla">Guaranteed response within 4 hours</span>
          </div>
          <div class="channel-card-actions">
            <button type="button" class="btn-channel-action btn-copy-email" id="btn-quick-copy-email">
              <span id="label-copy-email">Copy Email</span>
            </button>
            <a href="mailto:contact@codewithraa.me" class="btn-channel-action btn-channel-action--primary">
              <span>Send Mail</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          </div>
        </div>

        <!-- Channel 2: Discord -->
        <div class="channel-card">
          <div class="channel-card-icon channel-card-icon--discord">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"></path>
            </svg>
          </div>
          <div class="channel-card-info">
            <span class="channel-label">Direct Discord Handle</span>
            <strong class="channel-value">@RaaSki</strong>
            <span class="channel-sla">Developer &bull; Direct Message Portal</span>
          </div>
          <div class="channel-card-actions">
            <button type="button" class="btn-channel-action" id="btn-quick-copy-discord">
              <span id="label-copy-discord">Copy Handle</span>
            </button>
            <a href="https://discord.com/users/1105760622462914623" target="_blank" rel="noopener noreferrer" class="btn-channel-action btn-channel-action--discord">
              <span>Open Discord</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          </div>
        </div>

        <!-- Channel 3: LinkedIn -->
        <div class="channel-card">
          <div class="channel-card-icon channel-card-icon--blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </div>
          <div class="channel-card-info">
            <span class="channel-label">Professional Network</span>
            <strong class="channel-value">Samyog Dhakal</strong>
            <span class="channel-sla">Verified profile &amp; client endorsements</span>
          </div>
          <div class="channel-card-actions">
            <a href="https://www.linkedin.com/in/samyog-dhakal/" target="_blank" rel="noopener noreferrer" class="btn-channel-action btn-channel-action--primary">
              <span>View Profile</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Jump to Detailed Form Footer -->
      <div class="connect-footer-bar">
        <span>Need a formal architectural review or project estimate?</span>
        <button type="button" class="btn-jump-form" id="btn-jump-to-form">
          <span>Open Full Consultation Form</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
        </button>
      </div>
    </div>
  </div>
</dialog>

<style>
  .connect-dialog {
    padding: 0;
    border: none;
    background: transparent;
    max-width: 680px;
    width: calc(100% - 2rem);
    margin: auto;
    color: var(--color-text-primary);
    overflow: visible;
  }

  .connect-dialog::backdrop {
    background: rgba(11, 15, 25, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .connect-modal-box {
    background: #0F1626;
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: var(--radius-2xl);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.7), 0 0 35px rgba(16, 185, 129, 0.15);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: connectModalPop 0.28s var(--ease-out-expo) forwards;
  }

  @keyframes connectModalPop {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(12px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .connect-modal-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    background: rgba(14, 20, 34, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .connect-topbar-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .connect-topbar-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: #34D399;
    letter-spacing: 0.8px;
    margin-left: 8px;
  }

  .btn-connect-close {
    background: transparent;
    border: none;
    color: var(--color-text-tertiary);
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--duration-fast) ease;
  }

  .btn-connect-close:hover {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.08);
  }

  .connect-modal-body {
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .connect-header-area {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .connect-status-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: #34D399;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    width: fit-content;
  }

  .status-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 8px #10B981;
    animation: dotPulse 2s infinite alternate;
  }

  .connect-title {
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 4px 0 0;
  }

  .connect-desc {
    font-size: var(--size-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin: 0;
  }

  /* Channels Grid */
  .connect-channels-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .channel-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 14px 18px;
    background: rgba(19, 27, 46, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    transition: all var(--duration-fast) ease;
  }

  .channel-card:hover {
    border-color: rgba(6, 182, 212, 0.4);
    background: rgba(22, 32, 54, 0.9);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
  }

  .channel-card-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .channel-card-icon--cyan {
    background: rgba(6, 182, 212, 0.12);
    border: 1px solid rgba(6, 182, 212, 0.3);
    color: #22D3EE;
  }

  .channel-card-icon--discord {
    background: rgba(88, 101, 242, 0.15);
    border: 1px solid rgba(88, 101, 242, 0.35);
    color: #818CF8;
  }

  .channel-card-icon--blue {
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.3);
    color: #60A5FA;
  }

  .channel-card-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }

  .channel-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .channel-value {
    font-size: 13px;
    font-weight: 700;
    color: #F8FAFC;
  }

  .channel-sla {
    font-size: 11px;
    color: #64748B;
  }

  .channel-card-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .btn-channel-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    border-radius: var(--radius-md);
    cursor: pointer;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: #E2E8F0;
    transition: all var(--duration-fast) ease;
  }

  .btn-channel-action:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .btn-channel-action--primary {
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.25), rgba(16, 185, 129, 0.25));
    border-color: rgba(6, 182, 212, 0.4);
    color: #FFFFFF;
  }

  .btn-channel-action--primary:hover {
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.4), rgba(16, 185, 129, 0.4));
    border-color: #06B6D4;
    box-shadow: 0 2px 10px rgba(6, 182, 212, 0.3);
  }

  .btn-channel-action--discord {
    background: rgba(88, 101, 242, 0.2);
    border-color: rgba(88, 101, 242, 0.4);
    color: #FFFFFF;
  }

  .btn-channel-action--discord:hover {
    background: rgba(88, 101, 242, 0.35);
    border-color: #5865F2;
  }

  /* Bottom Jump Bar */
  .connect-footer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 12px;
    color: var(--color-text-secondary);
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-jump-form {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: none;
    font-family: var(--font-primary);
    font-size: 12px;
    font-weight: 700;
    color: #38BDF8;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--duration-fast) ease;
  }

  .btn-jump-form:hover {
    color: #7DD3FC;
  }

  @media (max-width: 640px) {
    .channel-card {
      flex-direction: column;
      align-items: flex-start;
    }
    .channel-card-actions {
      width: 100%;
      justify-content: flex-end;
    }
  }
</style>
